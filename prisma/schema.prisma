generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- better-auth core tables ----------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // Agently billing — credit plans. 1 credit = $0.01 of provider cost.
  plan             String    @default("free") // free | starter | pro | scale
  planStatus       String    @default("active") // active | past_due | canceled
  runsQuota        Int       @default(50) // legacy run quota; monthly credits live in creditBalance
  runsUsed         Int       @default(0) // legacy counter, used once to migrate onto credits
  creditBalance    Decimal   @default(50) @db.Decimal(14, 6) // monthly plan credits left; resets each cycle
  topupBalance     Decimal   @default(0) @db.Decimal(14, 6) // purchased credits; they do not expire
  creditsMigrated  Boolean   @default(false)
  paystackCustomer String?
  cardAuthCode     String?
  cardLast4        String?
  cardBank         String?
  nextBillingAt    DateTime?

  hiredAgents  HiredAgent[]
  payments     Payment[]
  usageLedger  UsageLedger[]
  activeRuns   ActiveRun[]
  connections  Connection[]
  runLogs      RunLog[]
  approvalsAll Approval[]
  customAgents CustomAgent[]

  conversations       Conversation[]
  assistantTasks      AssistantTask[]
  assistantApprovals  AssistantApproval[]
  memoryFacts         MemoryFact[]
  episodes            Episode[]
  docChunks           DocChunk[]
  assistantJobs       AssistantJob[]
  routines            Routine[]
  auditEvents         AuditEvent[]
  tokenSecrets        TokenSecret[]
  effectLedger        EffectLedger[]
  notes               Note[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- Agently domain ----------
// Tables below are kept. Do not drop them.
// hired_agent, custom_agent, run_log, and approval are still read by the dashboard,
// the schedule cron, and the Composio webhook. The template gallery and the old
// create-agent page no longer insert rows.
// doc_chunk is no longer written (the old chat upload route is gone). Routine turns
// still read any chunks that already exist.

model HiredAgent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String // template slug from bots.json, or "custom:<customAgentId>"
  name      String
  tier      String // lite | standard | pro (complexity badge)
  schedule  String    @default("daily") // daily | hourly | event
  status    String    @default("active") // active | paused | canceled
  approvalMode String @default("auto") // auto | approve (outbound actions wait for the owner)
  runsUsed  Int       @default(0) // lifetime per-agent stat
  memory    String    @default("") // self-learned facts & lessons, updated after each run
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  runLogs   RunLog[]
  approvals Approval[]

  @@unique([userId, slug])
  @@map("hired_agent")
}

// One row per user per connected app (Composio connected account)
model Connection {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolkit           String // display name, e.g. "Google Calendar"
  composioSlug      String // e.g. "googlecalendar"
  status            String   @default("pending") // pending | active | failed
  composioAccountId String?
  scopes            String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, toolkit])
  @@map("connection")
}

// Cached Composio managed auth configs, one per toolkit (shared across users)
model AuthConfig {
  composioSlug String   @id
  configId     String
  createdAt    DateTime @default(now())

  @@map("auth_config")
}

model RunLog {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String
  agent      HiredAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status     String    @default("running") // running | success | error | waiting | rejected
  trigger    String    @default("schedule") // schedule | event | manual
  summary    String    @default("")
  trace      Json? // executed tool calls: [{tool, ok, error?}]
  state      Json? // checkpoint: {stepIndex, context, pending} — resume point for waiting runs
  stopReason String? // DONE|FAILED|STEP_BUDGET|TOKEN_BUDGET|LOOP_DETECTED|WAITING_APPROVAL|DENIED|SKIPPED_PRECONDITION|WAITING_EXPIRED
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  approvals Approval[]

  @@index([userId, startedAt])
  @@map("run_log")
}

// An outbound action an agent prepared but did not execute — waits for the owner.
model Approval {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String
  agent      HiredAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runLogId   String
  runLog     RunLog    @relation(fields: [runLogId], references: [id], onDelete: Cascade)
  tool       String // Composio tool slug, e.g. SLACK_CHAT_POST_MESSAGE
  args       String // exact JSON arguments the agent prepared
  gist       String // human-readable one-liner for the inbox
  status     String    @default("pending") // pending | approved | rejected
  result     String    @default("") // execution result note after approval
  stepIndex  Int       @default(-1) // procedure step this call belongs to (-1 = legacy loop)
  expiresAt  DateTime? // single-use and perishable (Ch49)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
  @@map("approval")
}

// User-created agents (beyond the built-in templates)
model CustomAgent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String
  idea         String   @default("")
  instructions String // the agent's prompt / playbook
  toolkits     String[] // display names
  procedure Json? // ordered tool steps [{tool, purpose}] — the runtime walks these
  steps        String[] // plain-language workflow steps from the AI plan
  schedule     String   @default("daily") // daily | hourly | event
  visibility   String   @default("private") // private | public (community template)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("custom_agent")
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference   String   @unique
  amountKobo  Int
  currency    String   @default("NGN")
  status      String   @default("pending") // pending | success | failed
  kind        String // plan | topup | recurring
  description String
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment")
}

// One row per metered provider charge, plus admission rows used for the hourly rate limit.
model UsageLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId     String   @default("")
  type      String // model | web_search | desktop | admission | spend_alert
  units     Json
  credits   Decimal  @default(0) @db.Decimal(14, 6)
  costUsd   Decimal  @default(0) @db.Decimal(14, 8)
  model     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([runId])
  @@map("usage_ledger")
}

// A run that is inside its wall-clock budget. Expired rows do not count toward concurrency.
model ActiveRun {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  startedAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
  @@map("active_run")
}

// One owner alert per UTC day, so a spend spike emails once.
model SpendAlert {
  day        String   @id
  spentUsd   Decimal  @db.Decimal(14, 4)
  notifiedAt DateTime @default(now())

  @@map("spend_alert")
}

// Processed Composio webhook deliveries — redelivery must be a no-op (Ch53)
model WebhookEvent {
  id         String   @id // webhook-id header (or payload hash fallback)
  receivedAt DateTime @default(now())

  @@map("webhook_event")
}

// ---------- Personal assistant (hybrid architecture) ----------

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  tasks    AssistantTask[]
  planning PlanningSession?

  @@index([userId, updatedAt])
  @@map("conversation")
}

// Slot-filling for a brief. Answers survive a reload. The plan is stored only after required slots are filled.
model PlanningSession {
  id             String       @id @default(cuid())
  userId         String
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  state          Json
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@map("planning_session")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  role           String // user | assistant
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

model AssistantTask {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         String        @default("running") // running | success | error | waiting
  stopReason     String?
  trigger        String        @default("chat") // chat | schedule | event
  summary        String        @default("")
  plan           Json?
  checkpoint     Json?
  trace          Json?
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  costUsd        Float         @default(0)
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  approvals AssistantApproval[]

  @@index([userId, createdAt])
  @@map("assistant_task")
}

// Exact, single-use, expiring approval for one proposed tool call.
model AssistantApproval {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String
  task           AssistantTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool           String
  args           Json
  digest         String
  status         String        @default("pending") // pending | approved | rejected | expired
  expiresAt      DateTime
  idempotencyKey String
  result         String        @default("")
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([userId, status])
  @@map("assistant_approval")
}

model MemoryFact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  source    String   @default("agent")
  embedding Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("memory_fact")
}

model Episode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  summary   String
  lesson    String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("episode")
}

model DocChunk {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId  String
  ordinal   Int
  text      String
  embedding Json?
  createdAt DateTime @default(now())

  @@index([userId, sourceId])
  @@map("doc_chunk")
}

model AssistantJob {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String // routine | event
  payload        Json
  status         String   @default("queued") // queued | running | done | failed
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  runAt          DateTime @default(now())
  idempotencyKey String   @unique
  lastError      String   @default("")
  createdAt      DateTime @default(now())

  @@index([status, runAt])
  @@map("assistant_job")
}

model Routine {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  cadence   String // hourly | daily | weekly | event
  prompt    String
  toolkit   String    @default("")
  enabled       Boolean   @default(true)
  sendsApproved Boolean   @default(false)
  nextRunAt     DateTime?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())

  @@index([enabled, nextRunAt])
  @@map("routine")
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  tool      String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_event")
}

// Direct MCP OAuth tokens. Composio keeps its own tokens for the long tail.
model TokenSecret {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  ciphertext String
  scopes     String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, provider])
  @@map("token_secret")
}

model Note {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text           String
  idempotencyKey String   @default("")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("note")
}

model EffectLedger {
  key       String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  result    Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("effect_ledger")
}
