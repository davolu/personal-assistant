flowchart TB
    classDef actor fill:#B3E65F,stroke:#6E9A24,color:#2F440B
    classDef interface fill:#B3E65F,stroke:#6E9A24,color:#2F440B
    classDef orchestrator fill:#9CE6FF,stroke:#2C97BB,color:#1C4657
    classDef agent fill:#B8ACFB,stroke:#8A7BE0,color:#231266
    classDef guardrail fill:#FFB575,stroke:#CC7830,color:#542700
    classDef human fill:#FD9AE7,stroke:#D756BA,color:#511341
    classDef tool fill:#FFE86D,stroke:#A28E26,color:#574900
    classDef data fill:#81E7DE,stroke:#259D92,color:#0E4343
    classDef external fill:#DDDDD8,stroke:#8A8A7E,color:#434339
    classDef observability fill:#BDD1B9,stroke:#81917D,color:#2C3C29
    subgraph L0["Users and channels (Untrusted input)"]
        user(["Web chat<br/><small>Next.js, streamed replies</small>"]):::actor
        mobile(["Mobile client<br/><small>extension: same HTTP API</small>"]):::actor
        events>"App events<br/><small>Composio webhooks</small>"]:::external
        cron["Scheduler tick<br/><small>hourly, daily, weekly</small>"]:::interface
    end
    subgraph L1["Edge and input guard (Authenticated, validated)"]
        stream["Streaming gateway<br/><small>SSE after the output filter</small>"]:::interface
        auth["Auth and sessions<br/><small>better-auth</small>"]:::interface
        input{{"Input filters<br/><small>jailbreak and size</small>"}}:::guardrail
        limits{{"Rate and cost limits<br/><small>per user, per day</small>"}}:::guardrail
        hooks{{"Webhook verifier<br/><small>HMAC and id dedupe</small>"}}:::guardrail
        queue["Task queue<br/><small>Postgres jobs, retries</small>"]:::orchestrator
    end
    subgraph L2["Orchestration (Code decides, model proposes)"]
        orch["Orchestrator<br/><small>state machine and budgets</small>"]:::orchestrator
        context["Context manager<br/><small>truncate, then pack</small>"]:::orchestrator
        planner(["Planner<br/><small>steps and success, checked</small>"]):::agent
        react(["ReAct loop<br/><small>act, observe, stop</small>"]):::agent
        registry["Tool registry<br/><small>dynamic, fails closed</small>"]:::orchestrator
        worker["Background worker<br/><small>in-process on the cron tick</small>"]:::orchestrator
    end
    subgraph L3["Models, memory, and policy (Deny by default)"]
        output{{"Output filter<br/><small>secrets and claim check</small>"}}:::guardrail
        memory[("Memory retrieval<br/><small>facts, episodes, documents</small>")]:::data
        router(["Model router<br/><small>strong, cheap, embed, fallback</small>"]):::agent
        gate{{"Effect gate<br/><small>hold external, deny unknown</small>"}}:::guardrail
        sub(["Research sub-agent<br/><small>read-only, one hop</small>"]):::agent
    end
    subgraph L4["Tool layer (Narrow, allowlisted, scoped)"]
        official["Official MCP<br/><small>client ready, servers external</small>"]:::tool
        builtin["Builtin MCP<br/><small>clock, notes, docs, memory</small>"]:::tool
        hub["MCP client hub<br/><small>one protocol, routes calls</small>"]:::tool
        human(["Approval decision<br/><small>exact, single-use, 72h</small>"]):::human
    end
    subgraph L5["State (Owner-scoped)"]
        blobs[("File store<br/><small>local disk; S3 later</small>")]:::data
        vectors[("Vector store<br/><small>JSON vectors; pgvector later</small>")]:::data
        vault[("Token vault<br/><small>AES-GCM per user</small>")]:::data
        checkpoint[("Checkpoints<br/><small>resume without replay</small>")]:::data
        composio["Composio<br/><small>1000+ apps, managed OAuth</small>"]:::tool
        audit["Audit log<br/><small>approvals, denials, expiry</small>"]:::observability
    end
    subgraph L6["Records and telemetry (Every component emits spans)"]
        postgres[("Postgres<br/><small>users, chats, tasks</small>")]:::data
        cost["Cost tracking<br/><small>per user, task, model</small>"]:::observability
        traces["Trace spans<br/><small>redacted span tree</small>"]:::observability
        connections[("Connections<br/><small>apps and scopes</small>")]:::data
        alerts["Logs and alerts<br/><small>errors and budget</small>"]:::observability
    end
    subgraph L7["Evals (Release gate)"]
        evals["Eval release gate<br/><small>golden set, PROMOTE or HOLD</small>"]:::observability
    end
    user -->|chat message| stream
    mobile -->|same API, later| stream
    stream -->|require session| auth
    auth -->|typed body| input
    input -->|size ok| limits
    limits ==>|within budget| orch
    events -.->|signed payload| hooks
    hooks ==>|deduped event| queue
    cron ==>|tick| queue
    queue ==>|claim due jobs| worker
    orch ==>|load context| context
    context ==>|fitted window| planner
    planner ==>|checked plan| react
    react ==>|step query| registry
    orch ==>|draft reply| output
    context -->|read memory| memory
    planner ==>|which model| router
    react ==>|action proposal| gate
    registry ==>|research hop| sub
    gate ==>|allowed call| hub
    gate -.->|hold send/delete/pay| human
    sub ==>|read-only calls| hub
    builtin ==>|MCP transport| official
    hub ==>|long-tail call| composio
    human -.->|decision| audit
    gate -->|save interrupt| checkpoint
    official -->|encrypt tokens| vault
    builtin -->|doc embeddings| vectors
    blobs -->|durable rows| postgres
    checkpoint -.->|state transitions| traces
    composio -->|linked accounts| connections
    audit -.->|denials and expiry| alerts
    traces -.->|token counts| cost
    traces -.->|golden cases| evals
