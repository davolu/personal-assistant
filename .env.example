# ---- Database (Postgres) ----
# Local docker compose: postgresql://assistant:assistant@localhost:5432/assistant
# Vercel: Storage → your Postgres → .env.local tab → POSTGRES_PRISMA_URL value
DATABASE_URL="postgresql://assistant:assistant@localhost:5432/assistant"

# ---- Auth (better-auth) ----
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# The app's own URL (local dev shown; set to your domain on Vercel)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Google sign-in (optional; app works without it) ----
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Paystack ----
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
# USD→NGN conversion used for billing (prices are set in USD)
NGN_RATE="1600"
# Secret for /api/cron/* and /api/assistant/cron (any random string).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when that env var is set.
BILLING_CRON_SECRET="change-me-too"
CRON_SECRET="change-me-too"

# ---- Assistant runtime ----
# Claude is the main model. The router uses the strong model to plan and act,
# and the cheap model for classification and summaries.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_STRONG="claude-sonnet-4-5"
ANTHROPIC_MODEL_CHEAP="claude-haiku-4-5"
# Optional. Used as the fallback chat model and for memory/document embeddings.
# Without it, retrieval is keyword-only and there is no fallback provider.
OPENAI_API_KEY=""
OPENAI_MODEL_FALLBACK="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Daily model-spend ceiling per user, in USD. A rough price table, not an invoice.
ASSISTANT_DAILY_BUDGET_USD="2"
# 32 bytes, base64. Required only when storing direct MCP user tokens.
# openssl rand -base64 32
TOKEN_VAULT_KEY=""
# Optional remote MCP servers. Tokens here are app-level, not per-user.
# Example: [{"name":"github","url":"https://example.com/mcp","token":""}]
MCP_SERVERS=""
COMPOSIO_API_KEY=""
# Webhook signing secret from Composio dashboard -> Settings -> Webhooks (whsec_...).
# Point the dashboard webhook URL at https://<your-app>/api/webhooks/composio
COMPOSIO_WEBHOOK_SECRET=""
LANGSMITH_API_KEY=""
