# ---- Database (Vercel Postgres / any PostgreSQL) ----
# From Vercel: Storage → your Postgres → .env.local tab → POSTGRES_PRISMA_URL value
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Auth (better-auth) ----
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# The app's own URL (local dev shown; set to your domain on Vercel)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Google sign-in (optional; app works without it) ----
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Paystack ----
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
# USD→NGN conversion used for billing (prices are set in USD)
NGN_RATE="1600"
# Secret to protect the recurring-billing endpoint (any random string)
BILLING_CRON_SECRET="change-me-too"

# ---- Agent runtime (used in the next phase) ----
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
COMPOSIO_API_KEY=""
LANGSMITH_API_KEY=""
