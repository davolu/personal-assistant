# ---- Database (Postgres) ----
# Local docker compose: postgresql://assistant:assistant@localhost:5432/assistant
# Vercel: Storage → your Postgres → .env.local tab → POSTGRES_PRISMA_URL value
# Both must be available at build time. DDL uses the unpooled URL.
DATABASE_URL="postgresql://assistant:assistant@localhost:5432/assistant"
DATABASE_URL_UNPOOLED="postgresql://assistant:assistant@localhost:5432/assistant"

# ---- Auth (better-auth) ----
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public site URL. On Vercel both must be https://agentdocker.io.
# Do not set either to the *.vercel.app deployment URL. Sign-in still
# returns to the trusted host the browser used, and falls back here.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional comma-separated origins that may sign in, besides the defaults
# (https://agentdocker.io, https://www.agentdocker.io, and this project's
# Vercel production URL), this project's Vercel preview URLs (VERCEL_URL,
# VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL),
# *-davolus-projects.vercel.app, and localhost.
# A wildcard for every *.vercel.app site is ignored.
TRUSTED_ORIGINS=""

# ---- Password reset email (optional; Forgot password is hidden when unset) ----
# Resend → API Keys. EMAIL_FROM must be a verified sender, for example
# AgentDocker <noreply@agentdocker.io>
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- Google sign-in (optional; the button is hidden when unset) ----
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorized JavaScript origins:
#   https://agentdocker.io
#   https://www.agentdocker.io
#   https://personal-assistant-five-taupe.vercel.app
#   http://localhost:3000
# Authorized redirect URIs:
#   https://agentdocker.io/api/auth/callback/google
#   https://www.agentdocker.io/api/auth/callback/google
#   https://personal-assistant-five-taupe.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Paystack ----
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
# USD→NGN conversion used for billing (prices are set in USD)
NGN_RATE="1600"
# Secret for /api/cron/* and /api/assistant/cron (any random string).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when that env var is set.
BILLING_CRON_SECRET="change-me-too"
CRON_SECRET="change-me-too"

# ---- Assistant runtime ----
# Claude is the main model. The router uses the strong model to plan and act,
# and the cheap model for classification and summaries.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_STRONG="claude-sonnet-4-5"
ANTHROPIC_MODEL_CHEAP="claude-haiku-4-5"
# Optional. Used as the fallback chat model and for memory/document embeddings.
# Without it, retrieval is keyword-only and there is no fallback provider.
OPENAI_API_KEY=""
OPENAI_MODEL_FALLBACK="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Daily model-spend ceiling per user, in USD. A rough price table, not an invoice.
ASSISTANT_DAILY_BUDGET_USD="2"
# 32 bytes, base64. Required only when storing direct MCP user tokens.
# openssl rand -base64 32
TOKEN_VAULT_KEY=""
# Optional remote MCP servers. Tokens here are app-level, not per-user.
# Example: [{"name":"github","url":"https://example.com/mcp","token":""}]
MCP_SERVERS=""
COMPOSIO_API_KEY=""
# Webhook signing secret from Composio dashboard -> Settings -> Webhooks (whsec_...).
# Point the dashboard webhook URL at https://<your-app>/api/webhooks/composio
COMPOSIO_WEBHOOK_SECRET=""
LANGSMITH_API_KEY=""

# ---- Agentic chat (/agentic-chat) ----
# The model picker uses whichever of these keys are set. Missing keys stay disabled.
# Optional. A registry id or slug to select by default, such as claude-opus-5-5.
# The other models stay in the picker. ANTHROPIC_MODEL_STRONG is used the same way when this is empty.
ANTHROPIC_MODEL=""
# Optional JSON array of extra models: [{"id":"my-ft","provider":"openai","label":"Fine-tune","model":"ft:gpt-4.1:acme"}]
AGENTIC_MODELS=""
# OPENAI_API_KEY is listed above. It enables GPT-4.1 and OpenAI computer use.
GOOGLE_GENERATIVE_AI_API_KEY=""
XAI_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Composio tool router. Same key as the assistant above.
# COMPOSIO_API_KEY is already listed above.
# TypeSafe Jev, the verify critic. Optional. Without it, a local check is used.
TYPESAFE_API_KEY=""
TYPESAFE_BASE_URL="https://api.typesafe.ai"
# Inngest durable runs. Leave AGENTIC_RUNTIME unset to run the graph in the API route.
AGENTIC_RUNTIME=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV=""
# Langfuse tracing. Both keys must be set or tracing is a no-op.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# E2B Desktop. One cloud computer per user. Optional until use_computer is needed.
E2B_API_KEY=""
E2B_IDLE_MS="600000"
# Budgets. Defaults: 40 tool calls, 3 failed approaches, 10 minutes active.
AGENTIC_MAX_TOOL_CALLS="40"
AGENTIC_MAX_APPROACHES="3"
AGENTIC_WALL_CLOCK_MS="600000"
AGENTIC_COMPACT_CHARS="80000"
AGENTIC_COMPUTER_STEPS="12"
AGENTIC_TASK_BUDGET_USD="1"
# Set to 0 to hide the page.
AGENTIC_CHAT=""
